// ============================================================================
//  Dungeon War – zásahy: šíp × príšera, príšera × hráč (obdĺžniky v pixeloch bludiska, dizajn kap. 13)
// ============================================================================

const HIT_ARROW: byte = 10               // šíp zasiahne príšeru, keď |dx| < 10 a |dy| < 10
const HIT_BODY: byte = 14                // príšera zasiahne hráča, keď |dx| < 14 a |dy| < 14
const HIT_SHOT: byte = 8                 // strela kostlivca zasiahne hráča

// Absolútny rozdiel bajtov cez pretečenie: |a - b| pre vzdialenosti < 128 (pixely bludiska sú najviac 252 od seba,
// ale zásahy sa testujú len na malé vzdialenosti, takže stačí). Vnorené if namiesto reťazí && – tie prekladač
// vyhodnocuje 16-bitovo cez dočasné bunky (meranie 2026-11-16: zásahy pre 2 hráčov ~46 rastrov).
inline function near(a: byte, b: byte, lim: byte): bool {
    var d: byte = a - b
    if (d >= 128) { d = 0 - d }
    return d < lim
}

// Krok 11: v každom snímku len polovica príšer (0–2 / 3–5). Šíp (4 px/snímok) prejde za 2 snímky 8 px pri obdĺžniku
// ±10 px, príšera najviac ~2 px – zásah sa nestratí, len môže prísť o snímok neskôr.
var colHalf: byte = 0
function collide(): void {
    var h: byte = colHalf
    colHalf = 3 - h
    for p = 0 to 1 {
        var alive: bool = false
        if (pstate[p] == PS_ALIVE) { if (pinv[p] == 0) { alive = true } }
        var ppx: byte = px[p]
        var ppy: byte = py[p]
        // hráč bez šípu, ktorý nežije (brána, výbuch, vonku, nezraniteľný), príšery netestuje (krok 11: s 1 hráčom
        // bola druhá polovica slučky zbytočná)
        if (alive || aon[p] != 0) { for i = h to h + 2 {
            if (mtype[i] != M_NONE) {
                var mx: byte = mxp[i]               // updateMonPos (raz za snímok)
                var my: byte = myp[i]
                var hitMon: bool = false
                var hx: byte = HIT_ARROW                 // strážca je široký 2 sprity (boss.cs64)
                var hy: byte = HIT_ARROW
                var boss: bool = mkind[i] == M_BOSS
                if (boss) { hx = HIT_BOSS_AX  hy = HIT_BOSS_AY }   // šíp: < 16 (near pretečie), za stenou nie (review k8 č. 1, 2)
                if (aon[p] != 0) {
                    if (near(ax[p], mx, hx)) {
                        if (near(ay[p], my, hy)) {
                            hitMon = true
                            aon[p] = 0
                            if (boss) { hitBoss(p) }
                            else {
                                award(p, 3, T_POINTS[mkind[i]])  // 100 / 200 / 500 / 1000 bodov (floor.cs64)
                                killMonster(i)
                            }
                        }
                    }
                }
                if (!hitMon && alive && mkind[i] != M_THIEF) {   // zlodej je bonusový cieľ – dotykom nezabíja
                    var bodyX: bool = false
                    if (boss) { bodyX = absDiff(ppx, mx) < HIT_BOSS_X }   // 20 > 16: near by pretieklo (stĺpec 0 vs 10)
                    else { bodyX = near(ppx, mx, HIT_BODY) }
                    if (bodyX) {
                        if (near(ppy, my, HIT_BODY)) {
                            killPlayer(p)
                            alive = false
                        }
                    }
                }
            }
        } }
        // šíp hráča p × druhý hráč: zasiahnutý stratí život, strelec +1000
        var q: byte = 1 - p
        if (aon[p] != 0) {
            if (pstate[q] == PS_ALIVE) {
                if (pinv[q] == 0) {
                    if (near(ax[p], px[q], HIT_ARROW)) {
                        if (near(ay[p], py[q], HIT_ARROW)) {
                            aon[p] = 0
                            killPlayer(q)
                            addScore(p, 2, 1)        // číslica tisícov
                        }
                    }
                }
            }
        }
        // strely kostlivcov × hráč
        if (alive) {
            for k = 0 to MAX_SHOT - 1 {
                if (son[k] != 0) {
                    if (near(shotX[k], ppx, HIT_SHOT)) {
                        if (near(shotY[k], ppy, HIT_SHOT)) {
                            son[k] = 0
                            killPlayer(p)
                        }
                    }
                }
            }
        }
    }
}
