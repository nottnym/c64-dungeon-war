// ============================================================================
//  Dungeon War – príšery: typy, pohyb po mriežke, AI, streľba kostlivcov, tiene, objavovanie (dizajn kap. 3 a 12)
//  Poloha = bunka (mcx, mcy) + posun moff (0 = v strede bunky, inak pixely od stredu v smere mdir).
//  Pohyb nepotrebuje delenie.
// ============================================================================

const MAX_MON: byte = 6
const M_NONE: byte = 0
const M_SLIME: byte = 1
const M_SKEL: byte = 2
const M_SHADE: byte = 3
const M_THIEF: byte = 4                 // zlodej pokladu (krok 7)
const M_BOSS: byte = 5                  // strážca hĺbky (krok 8, boss.cs64)

// vlastnosti podľa typu (index = typ)
const T_SPEED:  byte[] = [0, 128, 160, 224, 255, 96] // pixely za snímok × 256
const T_SPRITE: byte[] = [0, 136, 144, 152, 160, 162] // slizák 8–15, kostlivec 16–23, tieň 24–31, zlodej 32–33, golem 34–35
const T_COLOR:  byte[] = [0, 13, 15, 4, 7, 12]       // svetlozelená, svetlosivá, fialová, žltá, sivá
const T_POINTS: byte[] = [0, 1, 2, 5, 10, 0]         // stovky bodov, najviac 10 (addScore); strážca 2500 v hitBoss
const T_RADAR:  byte[] = [0, 5, 1, 4, 7, 2]          // farba bodky na radare (hires znak → < 8)

// Rýchlosť typu + zrýchlenie podlažia (floor.cs64), najviac 255; zlodej vždy najrýchlejší.
function speedOf(t: byte): byte {
    if (t == M_THIEF) { return 255 }
    var s: byte = T_SPEED[t]
    var b: byte = speedBonus
    if (t == M_BOSS) { s = s + bossBoost  b = baseBonus }   // strážca: zásahy, bez bonusu za ≤ 2 príšery (review k8 č. 5)
    if (b > 255 - s) { return 255 }
    return s + b
}
const COL_SLIME: byte = 13

// zloženie podlaží (4 × 6 príšer) – krok 7 doplní zásobu a ďalšie podlažia

var mtype: byte[6] = [0, 0, 0, 0, 0, 0]  // živý typ (0 = mŕtva)
var mkind: byte[6] = [0, 0, 0, 0, 0, 0]  // typ, ktorý sa vráti po smrti
var mcx:   byte[6] = [0, 0, 0, 0, 0, 0]
var mcy:   byte[6] = [0, 0, 0, 0, 0, 0]
var moff:  byte[6] = [0, 0, 0, 0, 0, 0]
var mdir:  byte[6] = [0, 0, 0, 0, 0, 0]
var mface: byte[6] = [0, 0, 0, 0, 0, 0]
var mspd:  byte[6] = [0, 0, 0, 0, 0, 0]
var macc:  byte[6] = [0, 0, 0, 0, 0, 0]
var mstep: byte[6] = [0, 0, 0, 0, 0, 0]
var mcool: byte[6] = [0, 0, 0, 0, 0, 0]  // kostlivec: snímky do ďalšieho výstrelu
var mcloak: byte[6] = [0, 0, 0, 0, 0, 0] // tieň: odpočet do prepnutia viditeľnosti
var mshow: byte[6] = [0, 0, 0, 0, 0, 0]  // tieň: 1 = práve viditeľný (zablysnutie)

// miesta objavenia (bunky) – rohy a stred, ďaleko od brán
const SPAWN_X: byte[] = [0, 10, 5, 2, 8, 5]
const SPAWN_Y: byte[] = [0, 0, 0, 2, 2, 3]

// stred bunky v pixeloch (bez násobenia)
const CELL_PX: byte[] = [0, 24, 48, 72, 96, 120, 144, 168, 192, 216, 240]

var rndState: byte = $5A
// 8-bit LFSR (Galois, polynóm $B8) – deterministický, bez čítania SID
function rand8(): byte {                     // "rnd" je vstavaná funkcia
    var s: byte = rndState
    if ((s & 1) != 0) { s = (s >> 1) ^ $B8 } else { s = s >> 1 }
    rndState = s
    return s
}

// Voľné smery z každej bunky (bity D_UP/D_DOWN/D_LEFT/D_RIGHT, bez tunelov a brán) – steny sa počas podlažia
// nemenia, takže sa predpočítajú pri nahratí podlažia (computeOpen) a AI, BFS, šípy čítajú len tabuľku.
var open: byte[66] = new byte[66]

function computeOpen(): void {
    var i: byte = 0
    for cy = 0 to MZ_H - 1 {
        for cx = 0 to MZ_W - 1 {
            var m: byte = 0
            if (cy > 0 && (cell[i - MZ_W] & 2) == 0) { m = m | D_UP }
            if (cy < MZ_H - 1 && (cell[i] & 2) == 0) { m = m | D_DOWN }
            if (cx > 0 && (cell[i - 1] & 1) == 0) { m = m | D_LEFT }
            if (cx < MZ_W - 1 && (cell[i] & 1) == 0) { m = m | D_RIGHT }
            open[i] = m
            i = i + 1
        }
    }
}

// Príšera smie ísť z bunky smerom d? (bez tunelov a brán)
inline function monCanGo(cx: byte, cy: byte, d: byte): bool {   // inline: AI ho volá 4–5× na rozhodnutie
    if (cy >= MZ_H) { return false }             // mimo bludiska (riadok brány) – nikdy nečítať za poľom cell
    return (open[cy * MZ_W + cx] & d) != 0
}

inline function absDiff(a: byte, b: byte): byte {      // inline: volá sa v horúcich slučkách
    if (a > b) { return a - b }
    return b - a
}

// ---------------------------------------------------------------------------
//  Mapa vzdialeností od hráča (BFS po 66 bunkách) – tiene idú najkratšou cestou
// ---------------------------------------------------------------------------
var dist: byte[66] = new byte[66]
var bfsQ: byte[66] = new byte[66]

// Najbližší živý hráč k bunke (Manhattan), 255 = žiadny.
function nearestPlayer(cx: byte, cy: byte): byte {
    var best: byte = 255
    var bd: byte = 255
    for p = 0 to 1 {
        if (pstate[p] == PS_ALIVE) {
            var d: byte = absDiff(cx, pcx[p]) + absDiff(cy, pcy[p])
            if (d < bd) { bd = d  best = p }
        }
    }
    return best
}

// BFS z buniek všetkých živých hráčov naraz (vzdialenosť k najbližšiemu); bez živého hráča z bunky hráča 1.
// Rozložené do viacerých snímkov (meranie 2026-11-16: celé BFS naraz ~120 rastrov → oneskorené snímky pri 2 hráčoch):
// bfsStart pripraví novú mapu v distN, bfsStep spracuje najviac BFS_STEP buniek za snímok a po dokončení ju skopíruje
// do dist. Kým nie je hotová, tiene idú podľa predošlej mapy (stará je len pár snímkov).
const BFS_STEP: byte = 16
var distN: byte[66] = new byte[66]
var bfsHead: byte = 0
var bfsTail: byte = 0
var bfsBusy: bool = false

function bfsStart(): void {
    for i = 0 to 65 { distN[i] = 255 }
    var tail: byte = 0
    for p = 0 to 1 {
        if (pstate[p] == PS_ALIVE) {
            var t: byte = pcy[p] * MZ_W + pcx[p]
            if (distN[t] != 0) { distN[t] = 0  bfsQ[tail] = t  tail = tail + 1 }
        }
    }
    if (tail == 0) {
        var t0: byte = pcy[0] * MZ_W + pcx[0]
        distN[t0] = 0
        bfsQ[0] = t0
        tail = 1
    }
    bfsHead = 0
    bfsTail = tail
    bfsBusy = true
}

function bfsStep(): void {
    var head: byte = bfsHead
    var tail: byte = bfsTail
    var k: byte = BFS_STEP
    while (head != tail && k != 0) {
        k = k - 1
        var c: byte = bfsQ[head]
        head = head + 1
        var nd: byte = distN[c] + 1
        var o: byte = open[c]                    // voľné smery bunky (computeOpen)
        var n: byte = 0
        if ((o & D_UP) != 0) { n = c - MZ_W  if (distN[n] == 255) { distN[n] = nd  bfsQ[tail] = n  tail = tail + 1 } }
        if ((o & D_DOWN) != 0) { n = c + MZ_W  if (distN[n] == 255) { distN[n] = nd  bfsQ[tail] = n  tail = tail + 1 } }
        if ((o & D_LEFT) != 0) { n = c - 1  if (distN[n] == 255) { distN[n] = nd  bfsQ[tail] = n  tail = tail + 1 } }
        if ((o & D_RIGHT) != 0) { n = c + 1  if (distN[n] == 255) { distN[n] = nd  bfsQ[tail] = n  tail = tail + 1 } }
    }
    bfsHead = head
    bfsTail = tail
    if (head == tail) {
        for i = 0 to 65 { dist[i] = distN[i] }
        bfsBusy = false
    }
}

// Celá mapa naraz (nová hra/podlažie – tiene majú hneď platnú mapu).
function computeDist(): void {
    bfsStart()
    while (bfsBusy) { bfsStep() }
}


// Mapa obsadenosti: každá živá príšera rezervuje bunku, v ktorej stojí, alebo do ktorej mieri (mclaim). occ[] = počet
// rezervácií. Mení sa pri rozhodnutí, objavení a smrti (meranie 2026-11-16: prechádzanie všetkých príšer pre každý
// kandidátsky smer robilo špičky).
var occ: byte[66] = new byte[66]
var mclaim: byte[6] = [255, 255, 255, 255, 255, 255]

function claimCell(i: byte, c: byte): void {
    var o: byte = mclaim[i]
    if (o != 255) { occ[o] = occ[o] - 1 }
    mclaim[i] = c
    if (c != 255) { occ[c] = occ[c] + 1 }
}

// Je bunka (nx, ny) obsadená inou príšerou? (vlastná rezervácia je vždy bunka, z ktorej sa rozhoduje)
inline function occupied(self: byte, nx: byte, ny: byte): bool {
    return occ[ny * MZ_W + nx] != 0
}

// AI v strede bunky: z voľných smerov (bez otočenia späť a bez obsadených buniek, ak je iná možnosť) najbližší
// k cieľu – slizák/kostlivec podľa vzdialenosti v bunkách, tieň podľa mapy BFS; slizák/kostlivec 1/4 náhodne.
function chooseDir(i: byte): byte {
    var cx: byte = mcx[i]
    var cy: byte = mcy[i]
    var back: byte = opposite(mdir[i])
    var tp: byte = nearestPlayer(cx, cy)         // cieľ = najbližší živý hráč (255 = nikto → túlanie)
    var tx: byte = 0
    var ty: byte = 0
    if (tp != 255) { tx = pcx[tp]  ty = pcy[tp] }
    var thief: bool = mkind[i] == M_THIEF
    if (thief) {                                 // zlodej: k bližšiemu tunelu, nikdy sa netúla
        tp = 0
        tx = 0
        if (cx >= 5) { tx = MZ_W - 1 }
        ty = TUN_ROW
    }
    var shade: bool = mkind[i] == M_SHADE || mkind[i] == M_BOSS   // tieň a strážca podľa mapy BFS
    var best: byte = 0
    var bestDist: byte = 255
    var n: byte = 0
    var cand: byte = 0                           // bitová maska voľných smerov
    var d: byte = 1
    while (d < 16) {
        if (d != back && monCanGo(cx, cy, d)) {
            var nx: byte = cx
            var ny: byte = cy
            if (d == D_UP) { ny = ny - 1 }
            if (d == D_DOWN) { ny = ny + 1 }
            if (d == D_LEFT) { nx = nx - 1 }
            if (d == D_RIGHT) { nx = nx + 1 }
            if (!occupied(i, nx, ny)) {
                cand = cand | d
                n = n + 1
                var dd: byte = 0
                if (shade) { dd = dist[ny * MZ_W + nx] } else { dd = absDiff(nx, tx) + absDiff(ny, ty) }
                if (dd < bestDist) { bestDist = dd  best = d }
            }
        }
        d = d << 1
    }
    if (n == 0) {                                // slepá ulička alebo všetko obsadené
        if (back != 0 && monCanGo(cx, cy, back)) {
            var bx: byte = cx
            var by: byte = cy
            if (back == D_UP) { by = by - 1 }
            if (back == D_DOWN) { by = by + 1 }
            if (back == D_LEFT) { bx = bx - 1 }
            if (back == D_RIGHT) { bx = bx + 1 }
            if (!occupied(i, bx, by)) { return back }   // inak počká (review č. 5: neprejsť cez inú príšeru)
        }
        return 0
    }
    // Hráč v bráne alebo mŕtvy → túlanie (inak by príšery čakali pri výstupe z brány).
    var wander: bool = tp == 255
    var r: byte = 64
    if (shade) { r = 16 }
    if (mkind[i] == M_BOSS) { r = 8 }
    if (thief) { r = 24 }
    if (n > 1 && (wander || rand8() < r)) {
        var k: byte = rand8() & 3
        d = 1
        while (true) {
            if ((cand & d) != 0) {
                if (k == 0) { return d }
                k = k - 1
            }
            d = d << 1
            if (d == 16) { d = 1 }
        }
    }
    return best
}

function spawnMonster(i: byte, typ: byte): void {
    mtype[i] = typ
    mkind[i] = typ
    mcx[i] = SPAWN_X[i]
    mcy[i] = SPAWN_Y[i]
    moff[i] = 0
    mdir[i] = 0
    mface[i] = D_DOWN
    macc[i] = 0
    mstep[i] = 0
    mspd[i] = speedOf(typ)
    mcool[i] = 75
    mcloak[i] = 150 + (rand8() & 63)
    mshow[i] = 0
    claimCell(i, mcy[i] * MZ_W + mcx[i])
}

// ---------------------------------------------------------------------------
//  Strely príšer (kostlivce): 2 sloty, 3 px/snímok, steny ako šíp hráča
// ---------------------------------------------------------------------------
const MAX_SHOT: byte = 2
const SHOT_SPEED: byte = 3
const SHOT_COOL: byte = 75               // 1,5 s

var son: byte[2] = [0, 0]
var sx: byte[2] = [0, 0]
var sy: byte[2] = [0, 0]
var sdir: byte[2] = [0, 0]
var sown: byte[2] = [0, 0]                // príšera, ktorá strelu vystrelila (najviac 1 strela na kostlivca)
var sbig: byte[2] = [0, 0]                // 1 = balvan strážcu (pomalší, iný sprite)

// Vidí kostlivec niektorého živého hráča v rovnej chodbe? Vracia smer alebo 0.
// Kostlivec nestrieľa na hráča bližšie ako SKEL_MIN_DIST buniek – zblízka (napr. hneď po objavení) by sa strele nedalo
// uhnúť (úprava 2026-11-17). Strážca hĺbky hádže balvany bez tohto obmedzenia.
const SKEL_MIN_DIST: byte = 3
var seeMin: byte = 1                     // najmenšia vzdialenosť v bunkách, na ktorú seesCell hlási hráča
function seesPlayer(i: byte): byte {
    seeMin = 1
    if (mkind[i] == M_SKEL) { seeMin = SKEL_MIN_DIST }
    for p = 0 to 1 {
        if (pstate[p] == PS_ALIVE) {
            var d: byte = seesCell(i, pcx[p], pcy[p])
            if (d != 0) { return d }
        }
    }
    return 0
}

function seesCell(i: byte, tx: byte, ty: byte): byte {
    var cx: byte = mcx[i]
    var cy: byte = mcy[i]
    var d: byte = 0
    var n: byte = 0                              // počet buniek k hráčovi (bližšie ako seeMin → nevidí)
    if (cy == ty && cx != tx) {
        d = D_RIGHT
        if (tx < cx) { d = D_LEFT }
        while (cx != tx) {
            if (!monCanGo(cx, cy, d)) { return 0 }
            if (d == D_RIGHT) { cx = cx + 1 } else { cx = cx - 1 }
            n = n + 1
        }
        if (n < seeMin) { return 0 }
        return d
    }
    if (cx == tx && cy != ty) {
        d = D_DOWN
        if (ty < cy) { d = D_UP }
        while (cy != ty) {
            if (!monCanGo(cx, cy, d)) { return 0 }
            if (d == D_DOWN) { cy = cy + 1 } else { cy = cy - 1 }
            n = n + 1
        }
        if (n < seeMin) { return 0 }
        return d
    }
    return 0
}

function fireShot(i: byte, d: byte): bool {
    for k = 0 to MAX_SHOT - 1 {
        if (son[k] != 0 && sown[k] == i) { return false }   // ešte letí jeho strela (review č. 2)
    }
    for k = 0 to MAX_SHOT - 1 {
        if (son[k] == 0) {
            sown[k] = i
            son[k] = 1
            sx[k] = CELL_PX[mcx[i]]
            sy[k] = CELL_PX[mcy[i]]
            sdir[k] = d
            sbig[k] = 0
            if (mkind[i] == M_BOSS) { sbig[k] = 1  sfx(SFX_THROW) } else { sfx(SFX_SKEL) }
            return true
        }
    }
    return false
}

// Posun strely/šípu o n pixelov so stenami (pozícia v gX, gY). Vracia false, ak narazil.
var gX: byte = 0
var gY: byte = 0
function advance(d: byte, n: byte): bool {
    for s = 1 to n {
        var ocx: byte = CELL_OF[gX]
        var ocy: byte = CELL_OF[gY]
        if (d == D_UP) { gY = gY - 1 }
        if (d == D_DOWN) { gY = gY + 1 }
        if (d == D_LEFT) { gX = gX - 1 }
        if (d == D_RIGHT) { gX = gX + 1 }
        if (CELL_OF[gX] != ocx || CELL_OF[gY] != ocy) {
            if (ocy >= MZ_H) {                              // z priechodu brány: hore áno, inak koniec
                if (d != D_UP) { return false }
            } else {
                if (!monCanGo(ocx, ocy, d)) { return false }
            }
        }
    }
    return true
}

function moveShots(): void {
    for k = 0 to MAX_SHOT - 1 {
        if (son[k] != 0) {
            gX = sx[k]
            gY = sy[k]
            var sp: byte = SHOT_SPEED
            if (sbig[k] != 0) { sp = BOULDER_SPEED }
            if (advance(sdir[k], sp)) { sx[k] = gX  sy[k] = gY } else { son[k] = 0 }
        }
    }
}

// ---------------------------------------------------------------------------
//  Pohyb, viditeľnosť, tvar
// ---------------------------------------------------------------------------
// Rozpočet AI rozhodnutí na snímok (meranie 2026-11-16: súbeh rozhodnutí viacerých príšer robil špičky > 1 snímok).
// Príšera v strede bunky bez rozpočtu počká na ďalší snímok.
var decBudget: byte = 2

function moveMonster(i: byte): void {
    if (mcool[i] != 0) { mcool[i] = mcool[i] - 1 }
    if (mkind[i] == M_BOSS) { tickBoss() }
    if (mkind[i] == M_SHADE) {                   // zablysnutie: 1 s viditeľný každé 3–4 s
        mcloak[i] = mcloak[i] - 1
        if (mcloak[i] == 0) {
            mshow[i] = mshow[i] ^ 1
            if (mshow[i] != 0) { mcloak[i] = 50  sfx(SFX_SHADE) } else { mcloak[i] = 150 + (rand8() & 63) }
        }
    }
    if (moff[i] == 0 && decBudget == 0) { return }      // rozhodnutie až v ďalšom snímku
    if (moff[i] == 0 && mkind[i] == M_THIEF && mcy[i] == TUN_ROW && (mcx[i] == 0 || mcx[i] == MZ_W - 1)) {
        claimCell(i, 255)                        // zlodej utiekol tunelom
        mtype[i] = M_NONE
        mkind[i] = M_NONE
        thiefState = THIEF_DONE
        return
    }
    var a: byte = macc[i] + mspd[i]
    var whole: bool = a < macc[i]                // prenos = celý pixel ("step" je kľúčové slovo)
    macc[i] = a
    if (!whole) { return }
    if (moff[i] == 0) {                          // stred bunky → rozhodnutie (a streľba kostlivca)
        decBudget = decBudget - 1
        var mk: byte = mkind[i]
        if ((mk == M_SKEL || mk == M_BOSS) && mcool[i] == 0) {
            var sd: byte = seesPlayer(i)
            if (sd != 0 && fireShot(i, sd)) {
                mcool[i] = SHOT_COOL
                if (mk == M_BOSS) {              // strážca: balvan každé 2–3 s, pri hode na chvíľu viditeľný
                    mcool[i] = 100 + (rand8() & 63)
                    if (bossShow < BOSS_THROW_SHOW) { bossShow = BOSS_THROW_SHOW }
                }
                mface[i] = sd                    // otočený k hráčovi a jedno rozhodnutie stojí (review č. 2)
                mdir[i] = 0
                return
            }
        }
        var d: byte = chooseDir(i)
        mdir[i] = d
        if (d == 0) { return }
        mface[i] = d
        var tc: byte = mcy[i] * MZ_W + mcx[i]   // rezervácia cieľovej bunky
        if (d == D_UP) { tc = tc - MZ_W }
        if (d == D_DOWN) { tc = tc + MZ_W }
        if (d == D_LEFT) { tc = tc - 1 }
        if (d == D_RIGHT) { tc = tc + 1 }
        claimCell(i, tc)
    }
    moff[i] = moff[i] + 1
    mstep[i] = mstep[i] + 1
    if (moff[i] == CELL) {                       // dorazil do stredu ďalšej bunky
        moff[i] = 0
        var d2: byte = mdir[i]
        if (d2 == D_UP) { mcy[i] = mcy[i] - 1 }
        if (d2 == D_DOWN) { mcy[i] = mcy[i] + 1 }
        if (d2 == D_LEFT) { mcx[i] = mcx[i] - 1 }
        if (d2 == D_RIGHT) { mcx[i] = mcx[i] + 1 }
    }
}

function monX(i: byte): byte {
    var x: byte = CELL_PX[mcx[i]]
    if (mdir[i] == D_RIGHT) { x = x + moff[i] }
    if (mdir[i] == D_LEFT) { x = x - moff[i] }
    return x
}

function monY(i: byte): byte {
    var y: byte = CELL_PX[mcy[i]]
    if (mdir[i] == D_DOWN) { y = y + moff[i] }
    if (mdir[i] == D_UP) { y = y - moff[i] }
    return y
}

// Tieň je vidieť len pri zablysnutí alebo bližšie ako 3 bunky od hráča; ostatné príšery vždy.
// Strážca rovnako, ale namiesto zablysnutí je viditeľný po zásahu, pri hode a na začiatku podlažia (bossShow).
function monVisible(i: byte): bool {
    var k: byte = mkind[i]
    if (k != M_SHADE && k != M_BOSS) { return true }
    if (torchTicks != 0) { return true }         // fakľa odhalí tiene
    if (k == M_SHADE) { if (mshow[i] != 0) { return true } }
    else { if (bossShow != 0) { return true } }
    var p: byte = nearestPlayer(mcx[i], mcy[i])
    if (p == 255) { return false }
    return absDiff(mcx[i], pcx[p]) + absDiff(mcy[i], pcy[p]) < 3
}

inline function monShape(i: byte): byte {              // inline: volá sa pre každý sprite každý snímok
    if (mkind[i] == M_THIEF) { return T_SPRITE[M_THIEF] + ((mstep[i] >> 3) & 1) }
    var f: byte = 0
    var d: byte = mface[i]
    if (d == D_LEFT) { f = 2 }
    if (d == D_UP) { f = 4 }
    if (d == D_DOWN) { f = 6 }
    if ((mstep[i] & 8) != 0) { f = f + 1 }
    return T_SPRITE[mkind[i]] + f
}

function monColor(i: byte): byte {
    if (mkind[i] == M_BOSS && bossFlash != 0) { return 1 }     // strážca po zásahu bielo zabliká
    return T_COLOR[mkind[i]]
}

// Poloha príšery v pixeloch bludiska – raz za snímok do polí (zásahy, sprity ju len čítajú).
var mxp: byte[6] = [0, 0, 0, 0, 0, 0]
var myp: byte[6] = [0, 0, 0, 0, 0, 0]
function updateMonPos(): void {
    for i = 0 to MAX_MON - 1 { mxp[i] = monX(i)  myp[i] = monY(i) }
}

// ---------------------------------------------------------------------------
//  Smrť a návrat príšer
// ---------------------------------------------------------------------------
const BOOM_TIME: byte = 24
const RESPAWN_TIME: byte = 150           // 3 s

var mboom: byte[6] = [0, 0, 0, 0, 0, 0]  // > 0 = výbuch (odpočet snímok)
var mresp: byte[6] = [0, 0, 0, 0, 0, 0]  // > 0 = čaká na návrat

// Zabitá príšera vybuchne; jej miesto zaberie ďalšia zo zásoby podlažia (inak ostane prázdne). Zlodej sa nevracia.
function killMonster(i: byte): void {
    claimCell(i, 255)
    mboom[i] = BOOM_TIME
    mresp[i] = 0
    sfx(SFX_KILL)
    if (mkind[i] == M_THIEF) {
        thiefState = THIEF_DONE
        doubleNext = true                        // ďalšie podlažie dvojnásobné body
    } else {
        var nk: byte = nextReserve()
        if (nk != M_NONE) { mkind[i] = nk  mresp[i] = RESPAWN_TIME }
    }
    mtype[i] = M_NONE
}

const BLINK_TIME: byte = 50              // posledná 1 s pred návratom príšera bliká na mieste objavenia
const SAFE_DIST: byte = 2                // návrat sa odloží, kým je živý hráč bližšie (bunky, Manhattan)

function updateMonster(i: byte): void {
    if (mtype[i] != M_NONE) { moveMonster(i)  return }
    if (mboom[i] != 0) {
        mboom[i] = mboom[i] - 1
        if (mboom[i] == 0) {                     // po výbuchu na miesto objavenia (blikanie tam)
            mcx[i] = SPAWN_X[i]
            mcy[i] = SPAWN_Y[i]
            moff[i] = 0
            mdir[i] = 0
            mface[i] = D_DOWN
        }
        return
    }
    if (mresp[i] == 0) { return }
    if (mresp[i] == 1) {                         // code review č. 4: nie pri živom hráčovi
        var np: byte = nearestPlayer(mcx[i], mcy[i])
        if (np != 255 && absDiff(mcx[i], pcx[np]) + absDiff(mcy[i], pcy[np]) < SAFE_DIST) { return }
    }
    mresp[i] = mresp[i] - 1
    if (mresp[i] == 0) { spawnMonster(i, mkind[i]) }
}

// Tvar spritu príšery: živá a viditeľná → animácia, výbuch → snímky výbuchu, inak 0 = skrytá.
inline function monSprite(i: byte): byte {
    if (mtype[i] != M_NONE) {
        if (monVisible(i)) { return monShape(i) }
        return 0
    }
    var t: byte = mboom[i]
    if (t == 0) {
        if (mresp[i] != 0 && mresp[i] <= BLINK_TIME && (mresp[i] & 4) != 0) { return monShape(i) }
        return 0
    }
    if (t > 16) { return SPR_BOOM }
    if (t > 8) { return SPR_BOOM + 1 }
    return SPR_BOOM + 2
}

// Príšery podlažia podľa LV_TYPES.
// Príšery podlažia (fInit z floor.cs64); v pokladnici žiadne.
function spawnFloor(): void {
    for c = 0 to 65 { occ[c] = 0 }
    for j = 0 to MAX_MON - 1 { mclaim[j] = 255 }
    for i = 0 to MAX_MON - 1 {
        mboom[i] = 0
        mresp[i] = 0
        if (isBonus || fInit[i] == M_NONE) { mtype[i] = M_NONE  mkind[i] = M_NONE } else { spawnMonster(i, fInit[i]) }
    }
    if (isBoss && !isBonus) { placeBoss() }
    son[0] = 0
    son[1] = 0
}

// Zlodej pokladu po vyčistení podlažia: objaví sa v strede bludiska (5,3), najďalej od tunelov, a uteká k bližšiemu.
// (Test 2026-11-16: z miesta objavenia 0 pri ľavom tuneli utiekol za ~0,7 s.)
function spawnThief(): void {
    spawnMonster(0, M_THIEF)
    sfx(SFX_THIEF)
    mcx[0] = 5
    mcy[0] = 3
    claimCell(0, 3 * MZ_W + 5)
}
