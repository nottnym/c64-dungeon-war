// ============================================================================
//  Dungeon War – stavový riadok: skóre (desiatkové číslice, bez 16-bit aritmetiky), životy, odpočet brány, hlášky
// ============================================================================

const C_HEART: byte = 148
const COL_HEART: byte = 2               // červená (hires znak)
const SCORE_COL1: byte = 9              // "PLAYER 1 " → číslice od stĺpca 9
const SCORE_COL2: byte = 34             // "PLAYER 2 " od stĺpca 25 → číslice od 34
const MAX_LIVES: byte = 6

var scoreD: byte[12] = new byte[12]     // hráč p: číslice scoreD[p*6 .. p*6+5], najvyššia prvá
var nextLife: byte[2] = [1, 1]          // ďalší život navyše pri tomto skóre (jednotka 10 000; tuning.cs64)

const T_QUEST_OVER: byte[] = screenCodes("QUEST OVER")
const T_PRESS_FIRE: byte[] = screenCodes("PRESS FIRE")

function scoreBase(p: byte): byte {
    if (p == 0) { return 0 }
    return 6
}

function scoreCol(p: byte): byte {
    if (p == 0) { return SCORE_COL1 }
    return SCORE_COL2
}

function showScore(p: byte): void {
    var b: byte = scoreBase(p)
    var c: byte = scoreCol(p)
    for i = 0 to 5 { poke(SCREEN + c + i, 48 + scoreD[b + i]) }
}

// Pripočíta k číslici na pozícii pos (0 = statisíce … 5 = jednotky) hodnotu v (0–9) s prenosom.
function addScore(p: byte, pos: byte, v: byte): void {
    var i: byte = scoreBase(p) + pos
    var b: byte = scoreBase(p)
    var c: byte = v
    while (c != 0) {
        var d: byte = scoreD[i] + c
        c = 0
        if (d >= 10) { d = d - 10  c = 1 }
        scoreD[i] = d
        if (i == b) { c = 0 } else { i = i - 1 }
    }
    showScore(p)
    // život navyše pri 10 000 a potom každých 20 000 bodov, najviac MAX_LIVES (kap. 6)
    v = scoreD[b] * 10 + scoreD[b + 1]          // skóre / 10 000 (najviac 99; nextLife skončí najviac na 101)
    while (v >= nextLife[p]) {
        nextLife[p] = nextLife[p] + EXTRA_EVERY
        if (pstate[p] != PS_OUT && plives[p] < MAX_LIVES) {
            plives[p] = plives[p] + 1
            showLives(p, plives[p])
            sfx(SFX_TORCH)
        }
    }
}

function resetScore(p: byte): void {
    var b: byte = scoreBase(p)
    for i = 0 to 5 { scoreD[b + i] = 0 }
    nextLife[p] = EXTRA_FIRST
    showScore(p)
}

// Srdiečka životov v riadku 1 (hráč 1 zľava, hráč 2 sprava).
function showLives(p: byte, n: byte): void {
    var c: byte = 0
    if (p != 0) { c = 40 - MAX_LIVES }
    for i = 0 to MAX_LIVES - 1 {
        var ch: byte = 32
        if (i < n) { ch = C_HEART }
        poke(SCREEN + 40 + c + i, ch)
        poke(COLRAM + 40 + c + i, COL_HEART)
    }
}

// Odpočet vedľa brány (stredný riadok brány, mimo spritu hráča – code review č. 7): hráč 1 vpravo od svojej
// brány, hráč 2 vľavo od svojej; 0 = zmazať.
function showGateCount(c0: byte, n: byte): void {
    var a: uint16 = SCREEN + rowAddr(MZ_Y + MZ_H * 3 + 1) + c0 + 3
    if (c0 != MZ_X) { a = a - 4 }
    var ca: uint16 = a - SCREEN + COLRAM
    if (n == 0) { poke(a, 32) }
    else { poke(a, 48 + n)  poke(ca, 7) }
}

// ---------------------------------------------------------------------------
//  Radar: 11 × 6 buniek ako 6 × 3 znaky (každý 2 × 2 bunky), riadky 21–23, stĺpce 17–22; prekresľujú sa len zmeny
// ---------------------------------------------------------------------------
const RAD_ROW: byte = 21
const RAD_COL: byte = 17
const C_RADAR: byte = 128                // + maska (bit 0 ĽH, 1 PH, 2 ĽD, 3 PD)
const BIT4: byte[] = [1, 2, 4, 8]
const T_RADAR_LBL: byte[] = screenCodes("RADAR")

// Inkrementálne: prekreslí sa len znak, z ktorého/do ktorého príšera zmenila bunku (prepočet všetkých 18 znakov
// každý snímok stál ~60 rastrov – meranie 2026-11-16).
var mrx: byte[6] = [255, 255, 255, 255, 255, 255]   // bunka, v ktorej je príšera na radare (255 = nie je)
var mry: byte[6] = [255, 255, 255, 255, 255, 255]

function initRadar(): void {
    for i = 0 to MAX_MON - 1 { mrx[i] = 255 }
    for r = 0 to 2 {
        var a: uint16 = SCREEN + rowAddr(RAD_ROW + r) + RAD_COL
        for c = 0 to 5 { poke(a + c, C_RADAR)  poke(a - SCREEN + COLRAM + c, 1) }
    }
    var b: uint16 = SCREEN + rowAddr(RAD_ROW + 3) + RAD_COL
    for i = 0 to 4 { poke(b + i, T_RADAR_LBL[i])  poke(b - SCREEN + COLRAM + i, 1) }   // hires text: farba < 8 (review č. 1)
}

// Prekreslí znak radaru (kx, ky) podľa príšer, ktoré v ňom práve sú.
function radarChar(kx: byte, ky: byte): void {
    var m: byte = 0
    var t: byte = 0
    for j = 0 to MAX_MON - 1 {
        if (mtype[j] != M_NONE) {
            var cx: byte = mcx[j]
            var cy: byte = mcy[j]
            if ((cx >> 1) == kx && (cy >> 1) == ky) {
                m = m | BIT4[(cx & 1) | ((cy & 1) << 1)]
                if (mkind[j] > t) { t = mkind[j] }
            }
        }
    }
    var a: uint16 = SCREEN + rowAddr(RAD_ROW + ky) + RAD_COL + kx
    poke(a, C_RADAR + m)
    poke(a - SCREEN + COLRAM, T_RADAR[t])
}

function updateRadar(): void {
    for i = 0 to MAX_MON - 1 {
        var nx: byte = 255
        var ny: byte = 255
        if (mtype[i] != M_NONE) { nx = mcx[i]  ny = mcy[i] }
        if (nx != mrx[i] || ny != mry[i]) {
            var ox: byte = mrx[i]
            var oy: byte = mry[i]
            mrx[i] = nx
            mry[i] = ny
            if (ox != 255) { radarChar(ox >> 1, oy >> 1) }
            if (nx != 255) { radarChar(nx >> 1, ny >> 1) }
        }
    }
}
