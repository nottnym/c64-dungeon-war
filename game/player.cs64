// ============================================================================
//  Dungeon War – hráči: pohyb po mriežke chodieb, steny, tunely, vstupná brána, sprite
//  Pozícia (px, py) v pixeloch od ľavého horného rohu bludiska; stred bunky (cx, cy) = (24·cx, 24·cy).
//  Smer sa mení len v strede bunky (okrem otočenia späť), takže postava je vždy „v strede chodby“.
// ============================================================================

const CELL: byte = 24
const GATE_Y: byte = 144                 // pozícia vo vstupnej bráne (riadok buniek 6 pod bludiskom)
const MAX_X: byte = 240                  // stred bunky 10
const TUN_Y: byte = 48                   // stred bunky v riadku tunelov (TUN_ROW · 24)
const TUN_SHUT_TIME: byte = 150          // tunel zavalený 3 s (50 Hz)

// smery: 0 stojí, inak bity ako std:joy (1 hore, 2 dole, 4 vľavo, 8 vpravo)
const D_UP: byte = 1
const D_DOWN: byte = 2
const D_LEFT: byte = 4
const D_RIGHT: byte = 8

// sprity (tools/make_gfx.py): hráč vpravo 0/1, vľavo 2/3, hore 4/5, dole 6/7; blok VIC = 128 + číslo
const SPR_BASE: byte = 128
const COL_P1: byte = 5                   // zelená
const COL_P2: byte = 8                   // oranžová

var px: byte[2] = [0, 240]
var py: byte[2] = [144, 144]
var pdir: byte[2] = [0, 0]               // aktuálny smer pohybu
var pface: byte[2] = [D_UP, D_UP]        // smer pohľadu (sprite)
var pstep: byte[2] = [0, 0]              // počítadlo pixelov pre animáciu
var tunShut: byte = 0                    // > 0 = tunely zavalené (odpočet snímok)

// Dá sa z bunky (cx, cy) ísť smerom d? Brána: z nej len hore; do nej sa už nevracia.
function canGo(cx: byte, cy: byte, d: byte): bool {
    if (cy == 6) { return d == D_UP }
    var i: byte = cy * MZ_W + cx
    if (d == D_UP) { return cy > 0 && (cell[i - MZ_W] & 2) == 0 }
    if (d == D_DOWN) { return cy < MZ_H - 1 && (cell[i] & 2) == 0 }
    if (d == D_LEFT) {
        if (cx == 0) { return cy == TUN_ROW && tunShut == 0 }
        return (cell[i - 1] & 1) == 0
    }
    if (cx == MZ_W - 1) { return cy == TUN_ROW && tunShut == 0 }
    return (cell[i] & 1) == 0
}

function opposite(d: byte): byte {
    if (d == D_UP) { return D_DOWN }
    if (d == D_DOWN) { return D_UP }
    if (d == D_LEFT) { return D_RIGHT }
    if (d == D_RIGHT) { return D_LEFT }
    return 0
}

// Z joysticku jeden smer (pri šikmom stlačení má prednosť zmena oproti aktuálnemu smeru).
function pickDir(joy: byte, cur: byte): byte {
    var j: byte = joy & 15
    var other: byte = j & (cur ^ 15)
    if (other != 0) { j = other }
    if ((j & D_UP) != 0) { return D_UP }
    if ((j & D_DOWN) != 0) { return D_DOWN }
    if ((j & D_LEFT) != 0) { return D_LEFT }
    if ((j & D_RIGHT) != 0) { return D_RIGHT }
    return 0
}

function closeTunnels(): void {
    tunShut = TUN_SHUT_TIME
    setTunnels(false)
}

function movePlayer(p: byte, joy: byte): void {
    var want: byte = pickDir(joy, pdir[p])
    var x: byte = px[p]
    var y: byte = py[p]
    var d: byte = pdir[p]
    if (want != 0 && want == opposite(d)) { d = want }      // otočenie späť kedykoľvek
    var atCenter: bool = (x % CELL) == 0 && (y % CELL) == 0
    if (atCenter) {
        var cx: byte = x / CELL
        var cy: byte = y / CELL
        // tunel: zo stredu krajnej bunky ďalej von → druhá strana
        if (cy == TUN_ROW && tunShut == 0) {
            if (cx == 0 && d == D_LEFT && (want == D_LEFT || want == 0)) {
                px[p] = MAX_X
                closeTunnels()
                return
            }
            if (cx == MZ_W - 1 && d == D_RIGHT && (want == D_RIGHT || want == 0)) {
                px[p] = 0
                closeTunnels()
                return
            }
        }
        if (want != 0 && canGo(cx, cy, want)) { d = want }
        else { if (d != 0 && !canGo(cx, cy, d)) { d = 0 } }
    }
    pdir[p] = d
    if (d == 0) { return }
    pface[p] = d
    if (d == D_UP) { y = y - 1 }
    if (d == D_DOWN) { y = y + 1 }
    if (d == D_LEFT) { x = x - 1 }
    if (d == D_RIGHT) { x = x + 1 }
    px[p] = x
    py[p] = y
    pstep[p] = pstep[p] + 1
}

// Tvar spritu podľa smeru pohľadu a fázy chôdze (každých 8 px).
function playerShape(p: byte): byte {
    var f: byte = 0
    var d: byte = pface[p]
    if (d == D_LEFT) { f = 2 }
    if (d == D_UP) { f = 4 }
    if (d == D_DOWN) { f = 6 }
    if ((pstep[p] & 8) != 0) { f = f + 1 }
    return SPR_BASE + f
}

// Súradnice spritu: ľavý horný pixel bunky 0 = obrazovka stĺpec MZ_X, riadok MZ_Y → X 24 + 8·3, Y 50 + 8·2 (+1 na stred).
function spriteX(p: byte): uint16 { return 48 + (uint16)px[p] }
function spriteY(p: byte): byte { return 67 + py[p] }

function updateTunnels(): void {
    if (tunShut == 0) { return }
    tunShut = tunShut - 1
    if (tunShut == 0) { setTunnels(true) }
}
