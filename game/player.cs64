// ============================================================================
//  Dungeon War – hráči: pohyb po mriežke chodieb, steny, tunely, vstupná brána, sprite
//  Pozícia (px, py) v pixeloch od ľavého horného rohu bludiska; stred bunky (cx, cy) = (24·cx, 24·cy).
//  Smer sa mení len v strede bunky (okrem otočenia späť), takže postava je vždy „v strede chodby“.
//  Pohyb ide o jednu bunku; v jej strede pokračuje len pri držanom joysticku, inak zastane.
// ============================================================================

const CELL: byte = 24
const GATE_Y: byte = 144                 // pozícia vo vstupnej bráne (riadok buniek 6 pod bludiskom)
const MAX_X: byte = 240                  // stred bunky 10
const TUN_Y: byte = 48                   // stred bunky v riadku tunelov (TUN_ROW · 24)
const TUN_SHUT_TIME: byte = 150          // tunel zavalený 3 s (50 Hz)

// smery: 0 stojí, inak bity ako std:joy (1 hore, 2 dole, 4 vľavo, 8 vpravo)
const D_UP: byte = 1
const D_DOWN: byte = 2
const D_LEFT: byte = 4
const D_RIGHT: byte = 8

// sprity (tools/make_gfx.py): hráč vpravo 0/1, vľavo 2/3, hore 4/5, dole 6/7; blok VIC = 128 + číslo
const SPR_BASE: byte = 128
const COL_P1: byte = 5                   // zelená
const COL_P2: byte = 8                   // oranžová

var px: byte[2] = [0, 240]
var py: byte[2] = [144, 144]
var pdir: byte[2] = [0, 0]               // aktuálny smer pohybu
var pface: byte[2] = [D_UP, D_UP]        // smer pohľadu (sprite)
var pstep: byte[2] = [0, 0]              // počítadlo pixelov pre animáciu
var pcx: byte[2] = [0, 10]               // posledná bunka, ktorej stredom hráč prešiel (cieľ AI)
var pcy: byte[2] = [5, 5]
// Otočenie na mieste: hráč stojaci čelom k stene sa pri joysticku do protismeru najprv len otočí (môže strieľať
// na druhú stranu); pohyb začne, až keď joystick drží ďalej TURN_HOLD snímok (úprava 2026-11-16).
const TURN_HOLD: byte = 10
var pturn: byte[2] = [0, 0]
var tunShut: byte = 0                    // > 0 = tunely zavalené (odpočet snímok)

// Dá sa z bunky (cx, cy) ísť smerom d? Brána: z nej len hore; do nej sa už nevracia.
// Voľné smery z tabuľky open[] (computeOpen, bez tunelov – tunel rieši movePlayer cez closeTunnels).
function canGo(cx: byte, cy: byte, d: byte): bool {
    if (cy == 6) { return d == D_UP }
    return (open[cy * MZ_W + cx] & d) != 0
}

function opposite(d: byte): byte {
    if (d == D_UP) { return D_DOWN }
    if (d == D_DOWN) { return D_UP }
    if (d == D_LEFT) { return D_RIGHT }
    if (d == D_RIGHT) { return D_LEFT }
    return 0
}

// Z joysticku jeden smer (pri šikmom stlačení má prednosť zmena oproti aktuálnemu smeru).
function pickDir(joy: byte, cur: byte): byte {
    var j: byte = joy & 15
    var other: byte = j & (cur ^ 15)
    if (other != 0) { j = other }
    if ((j & D_UP) != 0) { return D_UP }
    if ((j & D_DOWN) != 0) { return D_DOWN }
    if ((j & D_LEFT) != 0) { return D_LEFT }
    if ((j & D_RIGHT) != 0) { return D_RIGHT }
    return 0
}

function closeTunnels(): void {
    tunShut = TUN_SHUT_TIME
    setTunnels(false)
    sfx(SFX_TUNNEL)
}

function movePlayer(p: byte, joy: byte): void {
    var want: byte = pickDir(joy, pdir[p])
    var x: byte = px[p]
    var y: byte = py[p]
    var d: byte = pdir[p]
    // otočenie späť kedykoľvek – okrem cesty z brány (y > 120): do brány sa hráč nevracia (code review č. 3)
    if (want != 0 && want == opposite(d) && !(want == D_DOWN && y > CELL_PX[MZ_H - 1])) { d = want }
    var cx: byte = CELL_OF[x]                                // tabuľky namiesto x / 24 a x % 24 (rt_DivMod16)
    var cy: byte = CELL_OF[y]
    if (CELL_PX[cx] == x && CELL_PX[cy] == y) {              // v strede bunky
        if (cy < MZ_H) { pcx[p] = cx  pcy[p] = cy }
        // Pohyb ide vždy len o jednu bunku: v strede ďalšej sa pokračuje, len kým joystick drží smer
        // (2026-11-16). held = joystick stále tlačí aktuálny smer.
        var held: bool = (joy & d) != 0
        // tunel: zo stredu krajnej bunky ďalej von → druhá strana – pri držanom smere pohybu aj pri novom smere
        // z miesta / po zvislom príchode (code review č. 2: inak x pretieklo 0 → 255 bez zavalenia)
        if (cy == TUN_ROW && tunShut == 0) {
            if (cx == 0 && (want == D_LEFT || (held && d == D_LEFT))) {
                px[p] = MAX_X
                pcx[p] = MZ_W - 1                // bunka hneď po tuneli (review č. 3)
                closeTunnels()
                return
            }
            if (cx == MZ_W - 1 && (want == D_RIGHT || (held && d == D_RIGHT))) {
                px[p] = 0
                pcx[p] = 0
                closeTunnels()
                return
            }
        }
        if (d == 0) {                                    // stojí v strede bunky
            if (pturn[p] != 0) {                         // po otočení: pohyb až pri ďalej držanom smere
                if (want != pface[p]) { pturn[p] = 0 }
                else {
                    pturn[p] = pturn[p] - 1
                    if (pturn[p] != 0) { return }
                }
            } else {
                if (want != 0 && want == opposite(pface[p]) && !canGo(cx, cy, pface[p])) {
                    pface[p] = want                      // čelom k stene → len otočiť
                    pturn[p] = TURN_HOLD
                    return
                }
            }
        }
        if (want != 0 && canGo(cx, cy, want)) { d = want }
        else { if (!held || !canGo(cx, cy, d)) { d = 0 } }
    }
    pdir[p] = d
    if (d == 0) { return }
    pface[p] = d
    if (d == D_UP) { y = y - 1 }
    if (d == D_DOWN) { y = y + 1 }
    if (d == D_LEFT) { x = x - 1 }
    if (d == D_RIGHT) { x = x + 1 }
    px[p] = x
    py[p] = y
    pstep[p] = pstep[p] + 1
}

// Tvar spritu podľa smeru pohľadu a fázy chôdze (každých 8 px).
function playerShape(p: byte): byte {
    var f: byte = 0
    var d: byte = pface[p]
    if (d == D_LEFT) { f = 2 }
    if (d == D_UP) { f = 4 }
    if (d == D_DOWN) { f = 6 }
    if ((pstep[p] & 8) != 0) { f = f + 1 }
    return SPR_BASE + f
}

// Súradnice spritu: ľavý horný pixel bunky 0 = obrazovka stĺpec MZ_X, riadok MZ_Y → X 24 + 8·3, Y 50 + 8·2 (+1 na stred).
function spriteX(p: byte): uint16 { return 48 + (uint16)px[p] }
function spriteY(p: byte): byte { return 67 + py[p] }

function updateTunnels(): void {
    if (tunShut == 0) { return }
    tunShut = tunShut - 1
    if (tunShut == 0) { setTunnels(true) }
}

// ---------------------------------------------------------------------------
//  Stavy hráča, brána, smrť, životy (krok 4)
// ---------------------------------------------------------------------------
const PS_GATE: byte = 0                  // čaká vo vstupnej bráne (nezraniteľný), odpočet 5 s
const PS_ALIVE: byte = 1
const PS_DYING: byte = 2                 // výbuch
const PS_OUT: byte = 3                   // bez životov
const GATE_SECS: byte = 5
const DYING_TIME: byte = 48
const SPR_BOOM: byte = 167               // výbuch 1–3 = sprity 39–41 (128 + 39)

var pstate: byte[2] = [0, 0]
var ptimer: byte[2] = [0, 0]             // snímky do ďalšej sekundy odpočtu / trvanie výbuchu
var psecs: byte[2] = [0, 0]              // zostávajúce sekundy v bráne
var plives: byte[2] = [3, 3]
var pfirePrev: byte[2] = [0, 0]
var pinv: byte[2] = [0, 0]               // > 0 = nezraniteľný (snímky) po výstupe z brány
const INV_TIME: byte = 50

function gateCol(p: byte): byte {
    if (p == 0) { return MZ_X }
    return MZ_X + (MZ_W - 1) * 3
}

function gateX(p: byte): byte {
    if (p == 0) { return 0 }
    return MAX_X
}

// Hráč sa postaví do brány s odpočtom.
function enterGate(p: byte): void {
    pstate[p] = PS_GATE
    px[p] = gateX(p)
    py[p] = GATE_Y
    pdir[p] = 0
    pface[p] = D_UP
    psecs[p] = GATE_SECS
    ptimer[p] = 50
    pcx[p] = CELL_OF[px[p]]
    pcy[p] = MZ_H - 1
    setGateBars(gateCol(p), true)
    showGateCount(gateCol(p), GATE_SECS)
}

function leaveGate(p: byte): void {
    pstate[p] = PS_ALIVE
    pturn[p] = 0
    pdir[p] = D_UP                       // vyjde o jednu bunku hore (ďalej podľa joysticku)
    py[p] = GATE_Y - 1                   // mimo stredu bunky – inak by ho pravidlo „len pri držanom joysticku“ zastavilo
    setGateBars(gateCol(p), false)
    showGateCount(gateCol(p), 0)
    pinv[p] = INV_TIME
}

function killPlayer(p: byte): void {
    if (pstate[p] != PS_ALIVE) { return }
    pstate[p] = PS_DYING
    ptimer[p] = DYING_TIME
    aon[p] = 0
    sfx(SFX_DIE)
}

// Jeden snímok hráča podľa stavu (brána, živý – pohyb a streľba na stlačenie fire, výbuch).
function updatePlayer(p: byte, joy: byte): void {
    var fire: byte = joy & 16
    var press: bool = fire != 0 && pfirePrev[p] == 0
    pfirePrev[p] = fire
    var st: byte = pstate[p]
    if (st == PS_GATE) {
        ptimer[p] = ptimer[p] - 1
        if (ptimer[p] == 0) {
            ptimer[p] = 50
            psecs[p] = psecs[p] - 1
            showGateCount(gateCol(p), psecs[p])
        }
        if (press || psecs[p] == 0 || (joy & D_UP) != 0) { leaveGate(p) }
        return
    }
    if (st == PS_DYING) {
        ptimer[p] = ptimer[p] - 1
        if (ptimer[p] == 0) {
            plives[p] = plives[p] - 1
            showLives(p, plives[p])
            if (plives[p] == 0) { pstate[p] = PS_OUT } else { enterGate(p) }
        }
        return
    }
    if (st != PS_ALIVE) { return }
    if (pinv[p] != 0) { pinv[p] = pinv[p] - 1 }
    movePlayer(p, joy)
    if (press && aon[p] == 0) { fireArrow(p) }
}

function playerSprite(p: byte): byte {
    if (pstate[p] == PS_DYING) {
        var t: byte = ptimer[p]
        if (t > 32) { return SPR_BOOM }
        if (t > 16) { return SPR_BOOM + 1 }
        return SPR_BOOM + 2
    }
    return playerShape(p)
}

// ---------------------------------------------------------------------------
//  Šípy: jeden na hráča, 4 px/snímok, stena = koniec (test pri zmene bunky)
// ---------------------------------------------------------------------------
const SPR_ARROW_H: byte = 164            // šíp vodorovne = sprite 36
const SPR_ARROW_V: byte = 165            // šíp zvisle = sprite 37
const ARROW_SPEED: byte = 4

var aon: byte[2] = [0, 0]
var ax: byte[2] = [0, 0]
var ay: byte[2] = [0, 0]
var adir: byte[2] = [0, 0]

function fireArrow(p: byte): void {
    aon[p] = 1
    ax[p] = px[p]
    ay[p] = py[p]
    adir[p] = pface[p]
    sfx(SFX_SHOOT)
}

function moveArrow(p: byte): void {
    if (aon[p] == 0) { return }
    gX = ax[p]
    gY = ay[p]
    if (advance(adir[p], ARROW_SPEED)) { ax[p] = gX  ay[p] = gY } else { aon[p] = 0 }   // advance: monster.cs64
}

function arrowShape(p: byte): byte {
    if (adir[p] == D_UP || adir[p] == D_DOWN) { return SPR_ARROW_V }
    return SPR_ARROW_H
}

