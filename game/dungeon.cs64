// ============================================================================
//  Dungeon War – hlavný súbor (C#64)
//  Dizajn: docs/DungeonWar-design.html
//
//  Pamäť (kap. 10 dizajnu):
//    $0801-$83FF  kód C#64
//    $8000-$BFFF  VIC banka 2: obrazovka $8400 (ukazovatele spritov $87F8), znaky $8800,
//                 $9000-$9FFF tieň znakovej ROM pre VIC – CPU: "DW LEVELS", sprity $A000-$AFFF, hudba $B000-$BFFF
//    $C000-$CBFF  premenné C#64, halda $CC00-$CDFF
//    $CE00-$CFFF  tabuľky std:mux2 (nič iné tam nesmie byť)
//
//  Krok 9: zvuk (sound.cs64), titulka, koniec hry, najvyššie skóre na disku (screens.cs64), pauza RUN/STOP.
//  Krok 8: strážca hĺbky (boss.cs64) na 5., 10., … podlaží.
//  Krok 7: priebeh podlaží (floor.cs64) – zásoba príšer, zlodej, truhlice, fakle, temné podlažie, pokladnica.
//  Krok 6: hráč 2 (joystick port 1, pripojí sa tlačidlom fire), vzájomné zásahy. Sprity: 0 hráč 1, 1-6 príšery, 7 šíp 1,
//  8-9 strely príšer, 10 hráč 2, 11 šíp 2.
//  Ladenie: zápis n (1–24) na $02FF cez monitor → nová hra na podlaží n.
// ============================================================================

memoryLayout { vars = $C000  heap = $CC00  heapLimit = $CE00 }

uses Vic = "std:vic"
uses Joy = "std:joy"
uses Mux2 = "std:mux2"
uses "layout.cs64"
uses "tuning.cs64"
uses "maze.cs64"
uses "player.cs64"
uses "monster.cs64"
uses "hud.cs64"
uses "combat.cs64"
uses "floor.cs64"
uses "boss.cs64"
uses "sound.cs64"
uses "screens.cs64"

// Texty v hre sú po anglicky (rozhodnutie 2026-11-16).
const T_P1:    byte[] = screenCodes("PLAYER 1 000000")
const T_FLOOR: byte[] = screenCodes("FLOOR 01")
const T_P2:    byte[] = screenCodes("PLAYER 2 000000")
const T_LOADERR: byte[] = screenCodes("LOAD ERROR: DW LEVELS")

// VIC banka 2 ($8000), obrazovka $8400 ($D018 bity 4-7 = 1), znaky $8800 (bity 1-3 = 1), multicolor znaky.
function initVideo(): void {
    sei()
    poke($DD02, peek($DD02) | $03)
    poke($DD00, (peek($DD00) & $FC) | $01)
    poke($D018, $12)
    poke($D016, peek($D016) | $10)
    Vic.setBorder(Vic.BLACK)
    Vic.setBackground(Vic.BLACK)
    poke($D022, 11)                       // tmavosivá – škáry kameňa
    poke($D023, 9)                        // hnedá – dlažba
    cli()
}

// Obrazovka medzerami, farby bielou (bajtové slučky – v C#64 kratšie ako fillMemory s konštantami).
function clearScreen(): void {
    for i = 0 to 249 {
        poke(SCREEN + i, 32)
        poke(SCREEN + 250 + i, 32)
        poke(SCREEN + 500 + i, 32)
        poke(SCREEN + 750 + i, 32)
        poke(COLRAM + i, 1)
        poke(COLRAM + 250 + i, 1)
        poke(COLRAM + 500 + i, 1)
        poke(COLRAM + 750 + i, 1)
    }
}

// Text v kódoch obrazovky na riadok/stĺpec s farbou.
function printAt(row: byte, col: byte, readonly text: byte[], color: byte): void {
    var a: uint16 = SCREEN + rowAddr(row) + col
    var ca: uint16 = a - SCREEN + COLRAM
    var n: byte = (byte)text.length
    for i = 0 to n - 1 { poke(a + i, text[i])  poke(ca + i, color) }
}

function drawStatus(): void {
    printAt(0, 0, T_P1, 5)
    printAt(0, 25, T_P2, 7)                // text: farba < 8 (≥ 8 = multicolor znak)
    if (isBonus) { printAt(0, 16, T_TREASURY, 7) }   // krok 12.1: v pokladnici namiesto „FLOOR nn“
    else {
        printAt(0, 16, T_FLOOR, 1)
        var n: byte = floorNo
        poke(SCREEN + 22, 48 + n / 10)
        poke(SCREEN + 23, 48 + n % 10)
    }
    showScore(0)                           // texty vyššie majú „000000“ – skutočné skóre naspäť
    showScore(1)
}

// Vymaže riadky obrazovky od..po (medzery, biela).
function clearRows(r0: byte, r1: byte): void {
    var r: byte = r0
    while (r <= r1) {
        var a: uint16 = SCREEN + rowAddr(r)
        for c = 0 to 39 { poke(a + c, 32)  poke(a - SCREEN + COLRAM + c, 1) }
        r = r + 1
    }
}

const SPR_ARROW1: byte = 1 + MAX_MON     // logický sprite šípu hráča 1
const SPR_SHOT0: byte = 2 + MAX_MON      // strely príšer
const SPR_P2: byte = 4 + MAX_MON
const SPR_ARROW2: byte = 5 + MAX_MON
const N_SPRITES: byte = 6 + MAX_MON
const T_FLOOR_N:  byte[] = screenCodes("FLOOR")
const T_TREASURY: byte[] = screenCodes("TREASURY")
var hideAll: bool = false                // úvod podlažia: všetky sprity skryté
const T_JOIN:  byte[] = screenCodes("FIRE:JOIN")      // "=" vo vlastnom písme nie je
const T_BLANK9: byte[] = screenCodes("         ")
var p2Joined: bool = false
const DEBUG_LEVEL: uint16 = $02FF
var distKey: byte[5] = [255, 255, 255, 255, 255]   // bunky a stavy hráčov, pre ktoré platí mapa vzdialeností
// MERANIE (dočasné): max. dĺžka logiky snímku v rastroch / 2 – $02FD bez BFS, $02FE so BFS
const DBG_T: uint16 = $02FD
const DBG_LATE: uint16 = $02FB           // MERANIE: 16-bit počet pretečených snímkov hry ($02FB nižší, $02FC vyšší bajt)
var lastPlay: bool = false               // predošlý snímok bol celý snímok hry
// MERANIE (dočasné): zápis 1 na $02F4 → v najbližšom hernom snímku sa uložia rastre (/2) po fázach do $02F5–$02FB
const DBG_REQ: uint16 = $02F4
var dbgOn: byte = 0
function mark(k: byte): void {
    if (dbgOn == 0) { return }
    var rl: uint16 = peek($D012) | ((uint16)(peek($D011) & $80) << 1)
    var lines: uint16 = rl + 62
    if (rl >= 250) { lines = rl - 250 }
    poke(DBG_REQ + 1 + k, (byte)(lines >> 1))
}

// Sprity: multicolor, spoločné farby $D025 čierna (obrys), $D026 biela; std:mux2 s obrazovkou $8400.
function initSprites(): void {
    poke($D01C, $FF)
    poke($D025, 0)
    poke($D026, 1)
    Mux2.setScreen(SCREEN)
    Mux2.setCount(N_SPRITES)               // všetky skryté, kým ich drawSprites nenastaví
    Mux2.update()                          // prvý commit pred start()
    sei()
    irq(frameIrq)
    Mux2.start()
    cli()
}

// Odovzdanie spritu multiplexeru len pri zmene (meranie 2026-11-16: 10× setSprite každý snímok ≈ 106 rastrov).
// Pamätá sa posledná poloha (pixely bludiska), tvar (0 = skrytý) a farba; setY/setPos sú lacnejšie než setSprite.
var sprX: byte[12] = new byte[12]
var sprY: byte[12] = new byte[12]
var sprS: byte[12] = new byte[12]
var sprC: byte[12] = new byte[12]

inline function putSprite(n: byte, x: byte, y: byte, col: byte, shape: byte): void {   // inline: 12× za snímok
    if (shape == 0) {
        if (sprS[n] != 0) { Mux2.hide(n)  sprS[n] = 0 }
        return
    }
    // Priamy zápis do polí std:mux2 (krok 11): setPos/setSprite počítajú 9. bit X 16-bitovo (~93 inštrukcií,
    // ~6 rastrov na sprite a snímok). Tu bajtovo: X = 48 + x, 9. bit pri x >= 208. Každá zložka len pri zmene.
    var fresh: bool = sprS[n] == 0               // zo skrytého → zapísať aj polohu
    if (shape != sprS[n] || col != sprC[n]) {
        Mux2.sptr[n] = shape
        Mux2.scol[n] = col
        sprS[n] = shape
        sprC[n] = col
    }
    if (fresh || x != sprX[n]) {
        Mux2.sxlo[n] = x + 48
        var hi: byte = 0
        if (x >= 208) { hi = 1 }
        Mux2.sxhi[n] = hi
        sprX[n] = x
    }
    if (fresh || y != sprY[n]) { Mux2.sy[n] = y + 67  sprY[n] = y }
}

// Počet spritov, ktoré multiplexer spracúva (S_TOTAL = Mux2.st[0]). Triedi sa len prvých n položiek trvalej permutácie
// order[] – tá sa preto musí zoradiť nanovo (0, 1, 2 …), inak by medzi prvými n mohli ostať nepoužité sprity 10/11
// a potrebný sprite by vypadol (strela kostlivca bola neviditeľná a hráč zomrel „pri výstrele“ – hlásenie 2026-11-17).
// IRQ číta len snapshot (entryL), order[] používa iba update() v hlavnej slučke – nevolať z IRQ ani počas update().
function setMuxTotal(n: byte): void {
    Mux2.st[0] = n
    for i = 0 to N_SPRITES - 1 { Mux2.order[i] = i }
}

function drawSprites(): void {
    if (hideAll) {
        for n = 0 to N_SPRITES - 1 { putSprite(n, 0, 0, 0, 0) }
        return
    }
    var sh: byte = 0
    if (pstate[0] != PS_OUT) { sh = playerSprite(0) }
    putSprite(0, px[0], py[0], COL_P1, sh)
    var i0: byte = 0
    if (isBoss && mkind[0] == M_BOSS) { drawBoss()  i0 = 2 }   // golem = sprity 1 a 2 (boss.cs64)
    for i = i0 to MAX_MON - 1 { putSprite(1 + i, mxp[i], myp[i], monColor(i), monSprite(i)) }
    for k = 0 to MAX_SHOT - 1 {
        sh = 0
        var sc: byte = 15
        if (son[k] != 0) {
            sh = SPR_ARROW_H
            if (sdir[k] == D_UP || sdir[k] == D_DOWN) { sh = SPR_ARROW_V }
            if (sbig[k] != 0) { sh = SPR_BOULDER  sc = COL_BOULDER }
        }
        putSprite(SPR_SHOT0 + k, shotX[k], shotY[k], sc, sh)
    }
    sh = 0
    if (aon[0] != 0) { sh = arrowShape(0) }
    putSprite(SPR_ARROW1, ax[0], ay[0], 1, sh)
    sh = 0
    if (pstate[1] != PS_OUT) { sh = playerSprite(1) }
    putSprite(SPR_P2, px[1], py[1], COL_P2, sh)
    sh = 0
    if (aon[1] != 0) { sh = arrowShape(1) }
    putSprite(SPR_ARROW2, ax[1], ay[1], 7, sh)
}

// Hráč 2 sa pripojí (raz za hru) tlačidlom fire na joysticku 1.
function joinP2(): void {
    p2Joined = true
    setMuxTotal(N_SPRITES)                 // krok 11: sprity hráča 2 (10, 11) späť do multiplexera
    printAt(1, 31, T_BLANK9, 1)
    plives[1] = 3
    showLives(1, 3)
    pinv[1] = 0
    pfirePrev[1] = 16
    enterGate(1)
}

// Mapa vzdialeností sa prepočíta len pri zmene buniek alebo stavov hráčov.
function distChanged(): bool {
    var a: byte = 0
    if (pstate[0] == PS_ALIVE) { a = 1 }
    if (pstate[1] == PS_ALIVE) { a = a | 2 }
    if (pcx[0] == distKey[0] && pcy[0] == distKey[1] && pcx[1] == distKey[2] && pcy[1] == distKey[3] && a == distKey[4]) {
        return false
    }
    distKey[0] = pcx[0]
    distKey[1] = pcy[0]
    distKey[2] = pcx[1]
    distKey[3] = pcy[1]
    distKey[4] = a
    return true
}

// Nová hra od podlažia f: skóre, životy, hráč 2 čaká na pripojenie; potom úvod podlažia.
function newGame(f: byte): void {
    clearScreen()
    floorNo = f
    isBonus = false
    doubleNext = false
    resetScore(0)
    resetScore(1)
    plives[0] = 3
    showLives(0, 3)
    pstate[0] = PS_GATE
    pstate[1] = PS_OUT                     // hráč 2 sa pripojí tlačidlom fire na joysticku 1
    plives[1] = 0
    p2Joined = false
    setMuxTotal(N_SPRITES - 2)             // krok 11: bez hráča 2 multiplexer spracúva len 10 spritov
    showLives(1, 0)
    printAt(1, 31, T_JOIN, 7)
    pfirePrev[0] = 1                       // fire držaný z obrazovky QUEST OVER nevyvedie hneď z brány
    beginIntro()
}

// Úvod podlažia: „FLOOR nn“ alebo „TREASURY“, sprity skryté (INTRO_TIME snímok).
var introTimer: byte = 0
function beginIntro(): void {
    setMulticolor(true)                    // titulka beží bez multicolor znakov (pulseScores)
    clearRows(2, 24)
    hideAll = true
    introTimer = INTRO_TIME
    if (isBonus) { introTimer = INTRO_BONUS_TIME }   // krok 12.1: nápis TREASURY dlhšie
    clearBossHp()                          // ukazovateľ strážcu nepatrí do úvodu ďalšieho podlažia
    bassStop()
    musicPlay(MUS_JINGLE)                  // znelka podlažia (GT2)
    if (isBonus) { printAt(11, 16, T_TREASURY, 7) }
    else {
        printAt(11, 16, T_FLOOR_N, 1)
        poke(SCREEN + rowAddr(11) + 22, 48 + floorNo / 10)
        poke(SCREEN + rowAddr(11) + 23, 48 + floorNo % 10)
    }
    drawStatus()
}

// Začiatok podlažia: bludisko, príšery, predmety, hráči v bránach.
function startFloor(): void {
    clearRows(2, 24)
    hideAll = false
    floorLayout()                          // rozloženie, zrkadlenie, temné podlažie (floor.cs64)
    computeOpen()                          // voľné smery buniek pre AI/BFS/šípy (monster.cs64)
    wallColor = COL_WALL
    poke($D022, 11)                        // tmavosivá – škáry kameňa
    poke($D023, 9)                         // hnedá – dlažba
    if (isDark) {                          // temné podlažie: steny aj dlažba čierne, steny sa odhalia okolo hráčov
        wallColor = COL_DARK
        poke($D022, 0)
        poke($D023, 0)                     // (test 2026-11-16: bodky dlažby prezrádzali tvar bludiska)
    }
    drawMaze()
    drawStatus()
    if (!isBonus) { setupFloor(floorNo) }
    if (isBoss) { showBossHp() }
    spawnFloor()
    clearItems()
    thiefState = THIEF_NONE
    speedBonus = 0
    baseBonus = 0
    floorSecs = 0
    secFrames = 0
    doubleNow = doubleNext
    doubleNext = false
    litX[0] = 255
    litX[1] = 255
    tunShut = 0                            // code review č. 5 (drawMaze kreslí tunely otvorené)
    aon[0] = 0
    aon[1] = 0
    for p = 0 to 1 {
        if (pstate[p] == PS_DYING) { endDying(p) }   // umieral pri konci podlažia → život sa odpočíta teraz
        pinv[p] = 0
        if (plives[p] != 0) { enterGate(p) } else { pstate[p] = PS_OUT }
    }
    distKey[4] = 255                       // nové podlažie: mapu vzdialeností prepočítať
    computeDist()                          // a hneď celú (tiene nesmú ísť podľa mapy starého podlažia)
    initRadar()
    updateMonPos()                         // polohy spritov z novej hry hneď (review č. 4)
    if (isBonus) { startBonusItems() }
    bassStart()                            // podklad + efekty (GT2 počas hry nehrá)
    for k = 0 to 3 { poke(DBG_LATE + k, 0) }   // MERANIE za podlažie: $02FB–$02FC pretečenia, $02FD–$02FE najdlhší snímok
}


// Stavy hry v main (krok 9)
const ST_TITLE: byte = 0
const ST_INTRO: byte = 1
const ST_PLAY: byte = 2
const ST_OVER: byte = 3
const ST_ENTRY: byte = 4
const OVER_TIME: byte = 200              // 4 s „QUEST OVER" s hudbou konca hry
var state: byte = ST_TITLE
var stateTimer: byte = 0
var paused: bool = false
var stopPrev: bool = false

// Koniec hry → zadanie mena prvého hráča, ktorý sa dostal do tabuľky (hráč 2 len ak sa pripojil), inak titulka.
function afterGame(from: byte): void {
    var p: byte = from
    while (p < 2) {
        if ((p == 0 || p2Joined) && qualifies(p)) {
            showEntry(p)
            state = ST_ENTRY
            return
        }
        p = p + 1
    }
    showTitle()
    state = ST_TITLE
}

function main(): void {
    includeAt(A_CHARSET, "assets/charset")
    includeAt(A_SPRITES, "assets/sprites")
    includeAt(A_MUSIC, "assets/music")
    if (!loadFile("DW LEVELS")) {
        initVideo()
        clearScreen()
        printAt(12, 9, T_LOADERR, 2)
        while (true) { }
    }
    initSystem()                           // zariadenie, NMI
    loadScores()                           // pred spustením multiplexera (KERNAL LOAD)
    poke(1, $36)                           // BASIC ROM preč: CPU musí na $A000-$BFFF čítať RAM (hudba GT2 na $B000)
    initVideo()
    clearScreen()
    initSprites()
    poke($DC00, $FF)                       // KERNAL IRQ nechal $7F – klávesy by čítal joystick 1 (review k9 č. 5); len raz,
                                           // nie každý snímok: virtuálny joystick C64U zapisuje stav práve do $DC00
    showTitle()
    var firePrev0: bool = true
    var firePrev1: bool = true
    var frame: byte = 0
    poke(DEBUG_LEVEL, 0)
    poke(DBG_T, 0)                         // meranie od nuly (review č. 7)
    poke(DBG_T + 1, 0)
    while (true) {
        // Pevný krok hry 25 Hz (krok 11): každý priechod počas hry trvá presne 2 snímky – rýchlosti a časovače sú ladené
        // na tento krok (hra predtým nestíhala 50 Hz a bežala nepravidelne 25–50 krokov/s). S_FRAME (Mux2.st[4]) = medzi
        // posledným waitFrame a teraz už prišiel začiatok snímku; waitFrame ho na začiatku nuluje, preto sa číta pred ním.
        // (wasLate sa na to nehodí – po dvojitom čakaní ho frame-start bez nového update() nastaví.)
        var crossed: bool = Mux2.st[4] != 0
        if (lastPlay) {
            if (crossed) {                     // MERANIE: priechody dlhšie ako 1 snímok ($02FB–$02FC)
                var lc: byte = peek(DBG_LATE) + 1
                poke(DBG_LATE, lc)
                if (lc == 0) { poke(DBG_LATE + 1, peek(DBG_LATE + 1) + 1) }
            } else { Mux2.waitFrame() }        // logika skončila do snímku → počkať o snímok navyše
        }
        Mux2.waitFrame()                   // 1. začiatok snímku
        var wasPlay: bool = state == ST_PLAY && !paused   // meranie len v snímkoch hry (krok 10)
        var joy: byte = Joy.read2()        // 2. logika – hráč 1 port 2
        var joy1: byte = Joy.read1()       //            hráč 2 port 1
        var f0: bool = Joy.fire(joy)
        var f1: bool = Joy.fire(joy1)
        var press0: bool = f0 && !firePrev0   // nové stlačenie, každý port zvlášť (review k9 č. 6)
        var press1: bool = f1 && !firePrev1
        firePrev0 = f0
        firePrev1 = f1
        var press: bool = press0 || press1
        frame = frame + 1
        var dbg: byte = peek(DEBUG_LEVEL)          // ladenie: nová hra na podlaží dbg
        if (dbg != 0 && dbg <= 24) {
            poke(DEBUG_LEVEL, 0)
            paused = false
            soundPause(false)
            newGame(dbg)
            state = ST_INTRO
        }
        tickBorder()                               // krok 12.1: červený okraj po smrti strážcu (aj počas úvodu)
        if (state == ST_TITLE) {
            drawTitleSprites(frame)
            pulseScores(frame)                 // krok 12.1: farebná vlna na najvyššom skóre
            if (press) {
                newGame(1)
                state = ST_INTRO
            }
        } else { if (state == ST_INTRO) {
            introTimer = introTimer - 1
            if (introTimer == 0) { startFloor()  state = ST_PLAY }
        } else { if (state == ST_OVER) {
            stateTimer = stateTimer - 1
            if (stateTimer == 0) { afterGame(0) }
        } else { if (state == ST_ENTRY) {
            var ej: byte = joy
            var ep: bool = press0
            if (entryP == 1) { ej = joy1  ep = press1 }
            if (updateEntry(ej, ep)) {
                insertScore(entryP, entryName)
                saveErr = !saveScores()           // hlášku ukáže titulka (showTitle)
                afterGame(entryP + 1)
            }
        } else {
            if (joy == 0) {                        // RUN/STOP = pauza; s pohnutým joystickom 2 by sken vybral iné riadky
                var stopNow: bool = runStopDown()     // (review k9 č. 5) – vtedy sa stav nemení, nevznikne falošná hrana
                if (stopNow && !stopPrev) {
                    paused = !paused
                    soundPause(paused)
                    showPaused(paused)
                }
                stopPrev = stopNow
            }
            if (!paused) {
                if (peek(DBG_REQ) != 0 && (frame & 7) != 0) { dbgOn = 1  poke(DBG_REQ, 0) }
                mark(0)
                if (!p2Joined && Joy.fire(joy1)) { joinP2() }
                updatePlayer(0, joy)
                moveArrow(0)
                updatePlayer(1, joy1)
                moveArrow(1)
                updateTunnels()
                mark(1)
                decBudget = 1                      // krok 11: najviac 1 rozhodnutie AI za snímok (predtým 2)
                if (distChanged()) { bfsStart()  decBudget = 1 }    // mapa vzdialeností len pri zmene hráčov,
                else { if (bfsBusy) { bfsStep()  decBudget = 1 } }  // počítaná po častiach (BFS_STEP buniek za snímok)
                for i = 0 to MAX_MON - 1 { updateMonster(i) }
                updateMonPos()
                mark(2)
                moveShots()
                collide()
                mark(3)
                if ((frame & 1) == 0) { updateRadar() }   // krok 11: radar každý druhý snímok
                updateItems()
                updateDark()
                mark(4)
                sfxTick()
                if (updateFloor()) { advanceFloor()  beginIntro()  state = ST_INTRO }   // podlažie vyčistené
                if (pstate[0] == PS_OUT && pstate[1] == PS_OUT) {   // koniec, až keď sú vonku všetci hráči
                    son[0] = 0                         // strely nezamrznú na obrazovke (review č. 4)
                    son[1] = 0
                    bassStop()
                    musicPlay(MUS_OVER)
                    printAt(11, 15, T_QUEST_OVER, 2)
                    hideAll = true
                    stateTimer = OVER_TIME
                    state = ST_OVER
                }
            }
        } } } }
        if (state != ST_TITLE) { drawSprites() }
        mark(5)
        Mux2.update()                      // 3. commit – posledný zápis snímku
        mark(6)
        dbgOn = 0
        lastPlay = wasPlay && state == ST_PLAY && !paused
        if (lastPlay) {                           // MERANIE: počet priechodov hry ($02FD–$02FE), pri pevnom kroku 25/s
            var ic: byte = peek(DBG_T) + 1            // (najdlhší snímok modulo 312 sa nedal použiť – krok 10/11)
            poke(DBG_T, ic)
            if (ic == 0) { poke(DBG_T + 1, peek(DBG_T + 1) + 1) }
        }
    }
}
