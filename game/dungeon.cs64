// ============================================================================
//  Dungeon War – hlavný súbor (C#64)
//  Dizajn: docs/DungeonWar-design.html
//
//  Pamäť (kap. 10 dizajnu):
//    $0801-$83FF  kód C#64
//    $8000-$BFFF  VIC banka 2: obrazovka $8400 (ukazovatele spritov $87F8), znaky $8800,
//                 $9000-$9FFF tieň znakovej ROM pre VIC – CPU: "DW LEVELS", sprity $A000-$AFFF, hudba $B000-$BFFF
//    $C000-$CBFF  premenné C#64, halda $CC00-$CDFF
//    $CE00-$CFFF  tabuľky std:mux2 (nič iné tam nesmie byť)
//
//  Krok 5: kostlivce (streľba), tiene (neviditeľné, BFS), radar. Sprity: 0 hráč 1, 1-6 príšery, 7 šíp, 8-9 strely príšer.
//  Ladenie: zápis n (1–4) na $02FF cez monitor → nová hra na podlaží n.
// ============================================================================

memoryLayout { vars = $C000  heap = $CC00  heapLimit = $CE00 }

uses Vic = "std:vic"
uses Joy = "std:joy"
uses Mux2 = "std:mux2"
uses "layout.cs64"
uses "maze.cs64"
uses "player.cs64"
uses "monster.cs64"
uses "hud.cs64"
uses "combat.cs64"

// Texty v hre sú po anglicky (rozhodnutie 2026-11-16).
const T_P1:    byte[] = screenCodes("PLAYER 1 000000")
const T_FLOOR: byte[] = screenCodes("FLOOR 01")
const T_P2:    byte[] = screenCodes("PLAYER 2 000000")
const T_LOADERR: byte[] = screenCodes("LOAD ERROR: DW LEVELS")

// VIC banka 2 ($8000), obrazovka $8400 ($D018 bity 4-7 = 1), znaky $8800 (bity 1-3 = 1), multicolor znaky.
function initVideo(): void {
    sei()
    poke($DD02, peek($DD02) | $03)
    poke($DD00, (peek($DD00) & $FC) | $01)
    poke($D018, $12)
    poke($D016, peek($D016) | $10)
    Vic.setBorder(Vic.BLACK)
    Vic.setBackground(Vic.BLACK)
    poke($D022, 11)                       // tmavosivá – škáry kameňa
    poke($D023, 9)                        // hnedá – dlažba
    cli()
}

// Obrazovka medzerami, farby bielou (bajtové slučky – v C#64 kratšie ako fillMemory s konštantami).
function clearScreen(): void {
    for i = 0 to 249 {
        poke(SCREEN + i, 32)
        poke(SCREEN + 250 + i, 32)
        poke(SCREEN + 500 + i, 32)
        poke(SCREEN + 750 + i, 32)
        poke(COLRAM + i, 1)
        poke(COLRAM + 250 + i, 1)
        poke(COLRAM + 500 + i, 1)
        poke(COLRAM + 750 + i, 1)
    }
}

// Text v kódoch obrazovky na riadok/stĺpec s farbou.
function printAt(row: byte, col: byte, readonly text: byte[], color: byte): void {
    var a: uint16 = SCREEN + rowAddr(row) + col
    var ca: uint16 = a - SCREEN + COLRAM
    var n: byte = (byte)text.length
    for i = 0 to n - 1 { poke(a + i, text[i])  poke(ca + i, color) }
}

function drawStatus(): void {
    printAt(0, 0, T_P1, 5)
    printAt(0, 16, T_FLOOR, 1)
    printAt(0, 25, T_P2, 7)                // text: farba < 8 (≥ 8 = multicolor znak)
    var n: byte = level + 1
    poke(SCREEN + 22, 48 + n / 10)
    poke(SCREEN + 23, 48 + n % 10)
}

function showLevel(): void {
    loadLevel(level)
    computeOpen()                          // voľné smery buniek pre AI/BFS/šípy (monster.cs64)
    drawMaze()
    drawStatus()
}

const SPR_ARROW1: byte = 1 + MAX_MON     // logický sprite šípu hráča 1
const SPR_SHOT0: byte = 2 + MAX_MON      // strely príšer
const N_SPRITES: byte = 4 + MAX_MON
const DEBUG_LEVEL: uint16 = $02FF
var distX: byte = 255                    // bunka hráča, pre ktorú platí mapa vzdialeností
var distY: byte = 255
// MERANIE (dočasné): max. dĺžka logiky snímku v rastroch / 2 – $02FD bez BFS, $02FE so BFS
const DBG_T: uint16 = $02FD
// MERANIE (dočasné): zápis 1 na $02F4 → v najbližšom hernom snímku sa uložia rastre (/2) po fázach do $02F5–$02FB
const DBG_REQ: uint16 = $02F4
var dbgOn: byte = 0
function mark(k: byte): void {
    if (dbgOn == 0) { return }
    var rl: uint16 = peek($D012) | ((uint16)(peek($D011) & $80) << 1)
    var lines: uint16 = rl + 62
    if (rl >= 250) { lines = rl - 250 }
    poke(DBG_REQ + 1 + k, (byte)(lines >> 1))
}

// Sprity: multicolor, spoločné farby $D025 čierna (obrys), $D026 biela; std:mux2 s obrazovkou $8400.
function initSprites(): void {
    poke($D01C, $FF)
    poke($D025, 0)
    poke($D026, 1)
    Mux2.setScreen(SCREEN)
    Mux2.setCount(N_SPRITES)               // všetky skryté, kým ich drawSprites nenastaví
    Mux2.update()                          // prvý commit pred start()
    sei()
    irq(frameIrq)
    Mux2.start()
    cli()
}

// Odovzdanie spritu multiplexeru len pri zmene (meranie 2026-11-16: 10× setSprite každý snímok ≈ 106 rastrov).
// Pamätá sa posledná poloha (pixely bludiska), tvar (0 = skrytý) a farba; setY/setPos sú lacnejšie než setSprite.
var sprX: byte[12] = new byte[12]
var sprY: byte[12] = new byte[12]
var sprS: byte[12] = new byte[12]
var sprC: byte[12] = new byte[12]

function putSprite(n: byte, x: byte, y: byte, col: byte, shape: byte): void {
    if (shape == 0) {
        if (sprS[n] != 0) { Mux2.hide(n)  sprS[n] = 0 }
        return
    }
    if (shape != sprS[n] || col != sprC[n]) {
        Mux2.setSprite(n, 48 + (uint16)x, 67 + y, col, shape)
        sprS[n] = shape
        sprC[n] = col
        sprX[n] = x
        sprY[n] = y
        return
    }
    if (x != sprX[n]) {
        Mux2.setPos(n, 48 + (uint16)x, 67 + y)
        sprX[n] = x
        sprY[n] = y
        return
    }
    if (y != sprY[n]) { Mux2.setY(n, 67 + y)  sprY[n] = y }
}

function drawSprites(): void {
    var sh: byte = 0
    if (pstate[0] != PS_OUT) { sh = playerSprite(0) }
    putSprite(0, px[0], py[0], COL_P1, sh)
    for i = 0 to MAX_MON - 1 { putSprite(1 + i, mxp[i], myp[i], monColor(i), monSprite(i)) }
    for k = 0 to MAX_SHOT - 1 {
        sh = 0
        if (son[k] != 0) {
            sh = SPR_ARROW_H
            if (sdir[k] == D_UP || sdir[k] == D_DOWN) { sh = SPR_ARROW_V }
        }
        putSprite(SPR_SHOT0 + k, sx[k], sy[k], 15, sh)
    }
    sh = 0
    if (aon[0] != 0) { sh = arrowShape(0) }
    putSprite(SPR_ARROW1, ax[0], ay[0], 1, sh)
}

// Nová hra: podlažie, skóre, životy, príšery, hráč v bráne.
function newGame(): void {
    clearScreen()
    showLevel()
    resetScore(0)
    plives[0] = 3
    showLives(0, 3)
    aon[0] = 0
    tunShut = 0                            // code review č. 5 (drawMaze kreslí tunely otvorené)
    pinv[0] = 0
    pfirePrev[0] = 1                       // fire držaný z obrazovky QUEST OVER nevyvedie hneď z brány
    spawnLevel(level)
    distX = 255                            // nové podlažie: mapu vzdialeností prepočítať
    initRadar()
    enterGate(0)
    updateMonPos()                         // polohy spritov z novej hry hneď (review č. 4)
}

function main(): void {
    includeAt(A_CHARSET, "assets/charset")
    includeAt(A_SPRITES, "assets/sprites")
    if (!loadFile("DW LEVELS")) {
        initVideo()
        clearScreen()
        printAt(12, 9, T_LOADERR, 2)
        while (true) { }
    }
    initVideo()
    newGame()
    initSprites()
    var over: bool = false
    var firePrev: bool = true
    var frame: byte = 0
    poke(DEBUG_LEVEL, 0)
    poke(DBG_T, 0)                         // meranie od nuly (review č. 7)
    poke(DBG_T + 1, 0)
    distX = 255
    while (true) {
        Mux2.waitFrame()                   // 1. začiatok snímku
        var joy: byte = Joy.read2()        // 2. logika
        var fire: bool = Joy.fire(joy)
        var press: bool = fire && !firePrev   // nové stlačenie (code review č. 6)
        firePrev = fire
        frame = frame + 1
        var dbg: byte = peek(DEBUG_LEVEL)          // ladenie: nová hra na podlaží dbg
        if (dbg != 0 && dbg <= N_LEVELS) {
            poke(DEBUG_LEVEL, 0)
            level = dbg - 1
            newGame()
            over = false
        }
        if (over) {
            if (press) {
                newGame()
                over = false
            }
        } else {
            if (peek(DBG_REQ) != 0 && (frame & 7) != 0) { dbgOn = 1  poke(DBG_REQ, 0) }
            mark(0)
            updatePlayer(0, joy)
            moveArrow(0)
            updateTunnels()
            mark(1)
            decBudget = 2
            if (pcx[0] != distX || pcy[0] != distY) {           // mapa vzdialeností len pri zmene bunky hráča
                distX = pcx[0]
                distY = pcy[0]
                computeDist(distX, distY)
                decBudget = 1
            }
            for i = 0 to MAX_MON - 1 { updateMonster(i) }
            updateMonPos()
            mark(2)
            moveShots()
            collide()
            mark(3)
            updateRadar()
            mark(4)
            if (pstate[0] == PS_OUT) {
                son[0] = 0                         // strely nezamrznú na obrazovke (review č. 4)
                son[1] = 0
                printAt(11, 15, T_QUEST_OVER, 2)
                printAt(13, 15, T_PRESS_FIRE, 1)
                over = true
            }
        }
        drawSprites()
        mark(5)
        Mux2.update()                      // 3. commit – posledný zápis snímku
        mark(6)
        dbgOn = 0
        var rl: uint16 = peek($D012) | ((uint16)(peek($D011) & $80) << 1)
        var lines: uint16 = rl + 62               // od frame-start rastra 250: (rl - 250) mod 312
        if (rl >= 250) { lines = rl - 250 }
        var half: byte = (byte)(lines >> 1)
        var slot: uint16 = DBG_T
        if (decBudget == 1) { slot = DBG_T + 1 }     // snímok s BFS (alebo s jedným rozhodnutím)
        if (half > peek(slot)) { poke(slot, half) }
    }
}
